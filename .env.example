# ===========================
# Gaurav Minerals — Environment Variables
# ===========================
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and will NOT be committed.

# --- MongoDB Database ---
# Get a free MongoDB Atlas cluster at https://www.mongodb.com/atlas
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>
MONGODB_URI=mongodb+srv://your-username:your-password@cluster0.xxxxx.mongodb.net/gaurav-minerals

# --- SMTP Email Configuration ---
# Required to send actual emails. If not configured, emails are logged to the console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# The "From" address shown in outgoing emails
SMTP_FROM=noreply@gauravminerals.com

# The email address that receives contact & quote notifications
NOTIFICATION_EMAIL=ag.anil@yahoo.co.in

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
